# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF

# Лимит Bot API на загрузку файла ботом, в мегабайтах. Не трогай без локального telegram-bot-api.
MAX_FILE_SIZE_MB=50

# Сколько видео качаем одновременно
MAX_CONCURRENT_DOWNLOADS=3

# true, если видео нужно смотреть в Telegram Web или на старых Android. По умолчанию берём максимум (1080p H.265)
PREFER_H264=false

# Файл кэша file_id
CACHE_DB=cache.sqlite3

# Папка для временных файлов. Пусто означает системную temp
# DOWNLOAD_DIR=downloads

LOG_LEVEL=INFO
